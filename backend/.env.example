# Supabase -> Project Settings -> Database -> Connection string (Session pooler).
# postgresql:// is auto-converted to postgresql+asyncpg://. Special characters in the
# password (@ # $ ...) are percent-encoded automatically.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Output size of the embedding model (scam_patterns.embedding). Changing it needs a migration.
EMBEDDING_DIM=384

# Scoring (optional; defaults live in app/core/config.py)
# SIGNAL_WEIGHTS={"rules": 0.30, "classifier": 0.25, "url_intel": 0.15, "reputation": 0.10, "pattern_similarity": 0.05, "llm": 0.15}
# VERDICT_SUSPICIOUS_MIN=35
# VERDICT_SCAM_MIN=70
# STRONG_RULE_WEIGHT=0.8

# dev | test | prod
ENV=dev
LOG_LEVEL=INFO
