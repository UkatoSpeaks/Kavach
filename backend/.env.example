# Supabase -> Project Settings -> Database -> Connection string (Session pooler).
# postgresql:// is auto-converted to postgresql+asyncpg://. Special characters in the
# password (@ # $ ...) are percent-encoded automatically.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Chat model for the LLM explanation step, and the fallback used on 429/errors. Groq retires
# models; list what your key can use with GET https://api.groq.com/openai/v1/models.
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# low | medium | high for reasoning models (gpt-oss); leave empty for other models.
# GROQ_REASONING_EFFORT=low
# LLM_TIMEOUT_S=8
# LLM_CACHE_SIZE=500
# LLM_CACHE_TTL_S=3600
# LLM_MAX_DISAGREEMENT=50

# Local embedding model (fastembed, ONNX) for scam-pattern retrieval. EMBEDDING_DIM must match
# the model and scam_patterns.embedding (changing it needs a migration); changing the model
# needs a re-run of `python -m scripts.ingest_patterns`.
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# EMBEDDING_CACHE_DIR=.cache/fastembed

# Pattern-similarity signal (optional; see app/services/rag.py)
# PATTERN_TOP_K=3
# PATTERN_MIN_MARGIN=0.05
# PATTERN_FULL_MARGIN=0.20
# PATTERN_MIN_SIMILARITY=0.35
# PATTERN_MIN_WORDS=12

# Google Safe Browsing v4 (optional; the check is skipped when empty).
# https://developers.google.com/safe-browsing/v4/get-started
SAFE_BROWSING_API_KEY=
# HTTP_TIMEOUT_S=5
# URL_CACHE_TTL_HOURS=24

# Scoring (optional; defaults live in app/core/config.py)
# SIGNAL_WEIGHTS={"rules": 0.30, "classifier": 0.25, "url_intel": 0.15, "upi_check": 0.15, "reputation": 0.10, "pattern_similarity": 0.05, "llm": 0.15, "sender_check": 0.15, "fake_payment_proof": 0.15}
# VERDICT_SUSPICIOUS_MIN=35
# VERDICT_SCAM_MIN=70
# STRONG_RULE_WEIGHT=0.8

# Trained classifier (models/classifier.json, ~14 MB RAM). Missing file: signal unavailable.
# CLASSIFIER_ENABLED=true
# CLASSIFIER_MODEL_PATH=models/classifier.json
# CLASSIFIER_MIN_SCAM_PROBABILITY=0.9
# CLASSIFIER_ADVISORY_WEIGHT_FACTOR=0.5

# dev | test | prod ("production"/"development" also work). prod hides error details and
# turns off /docs unless ENABLE_DOCS=true.
ENV=dev
LOG_LEVEL=INFO
# ENABLE_DOCS=

# The pattern signal's embedding model takes ~560 MB RAM; set false on 512 MB instances.
# PATTERN_SIGNAL_ENABLED=true

# Screenshots (POST /analyze/screenshot). Groq vision first (needs GROQ_API_KEY; empty model:
# skipped), then the local OCR (RapidOCR, onnxruntime), loaded on first use. The local OCR
# adds ~110 MB RAM once loaded and peaks ~305 MB above the app while reading an image: set
# LOCAL_OCR_ENABLED=false on 512 MB instances. LOCAL_OCR_DEVANAGARI downloads ~10 MB of
# models into LOCAL_OCR_CACHE_DIR (python -m scripts.download_model does it ahead of time).
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# VISION_TIMEOUT_S=15
# LOCAL_OCR_ENABLED=true
# LOCAL_OCR_DEVANAGARI=true
# LOCAL_OCR_CACHE_DIR=.cache/rapidocr
# LOCAL_OCR_MAX_SIDE=1024

# Protection (per client IP, in memory; notation: 10/minute, 100/hour, 5/minute;50/day).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_ANALYZE=10/minute
# RATE_LIMIT_REPORT=5/minute
# GET /health/llm makes a real (tiny, cached 60 s) Groq call.
# RATE_LIMIT_HEALTH_LLM=6/minute
# Proxies in front of the app that append to X-Forwarded-For (Render: 2). 0 ignores it.
# TRUSTED_PROXY_HOPS=0
# Temporary diagnostic GET /debug/client-ip (resolved IP, hop count, worker PID).
# DEBUG_IP_ENDPOINT=false
# MAX_JSON_BODY_BYTES=65536
# MAX_UPLOAD_BODY_BYTES=5308416
# Browser origins allowed by CORS, comma-separated. Empty: none (dev: http://localhost:3000).
# CORS_ORIGINS=
